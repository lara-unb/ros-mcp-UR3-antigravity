# syntax=docker/dockerfile:1

# ==========================================
# Estágio 1: Builder (Oficina de Montagem)
# ==========================================
FROM ubuntu:22.04 AS builder

ENV DEBIAN_FRONTEND=noninteractive
WORKDIR /build

# Cache do APT para baixar dependências de sistema rapidamente em re-builds
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && apt-get install -y \
    python3 python3-pip python3-venv git build-essential curl

# Instala o uv via internet
RUN pip3 install uv

# Copia APENAS a pasta do servidor MCP primeiro. 
# Se você alterar qualquer outro arquivo do projeto, esta camada não será invalidada.
COPY ros-mcp-server/ /build/ros-mcp-server/

# Cria o ambiente virtual e instala as dependências Python (com cache persistente do UV)
WORKDIR /build/ros-mcp-server
ENV UV_CACHE_DIR=/root/.cache/uv
RUN --mount=type=cache,target=/root/.cache/uv \
    uv venv /opt/venv && \
    VIRTUAL_ENV=/opt/venv uv pip install .

# ==========================================
# Estágio 2: Runtime (Vitrine de Produção)
# ==========================================
FROM ubuntu:22.04 AS runtime

ENV DEBIAN_FRONTEND=noninteractive
WORKDIR /app

# Instala apenas as bibliotecas estritamente necessárias para rodar (Node e runtime do Python/GL)
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && apt-get install -y curl ca-certificates && \
    curl -fsSL https://deb.nodesource.com/setup_20.x | bash - && \
    apt-get install -y python3 python3-venv libgl1 libglib2.0-0 nodejs && \
    rm -rf /var/lib/apt/lists/*

# Traz o ambiente virtual pronto do estágio builder (reduzindo MBs de arquivos desnecessários)
COPY --from=builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Mantive a cópia do seu binário agy, caso ele não seja pesado. 
# Se ele for instalável online depois, você pode substituir por um RUN wget.
COPY vendor/bin/agy /usr/local/bin/agy
RUN chmod +x /usr/local/bin/agy

# Copia o restante do repositório por último (isso muda muito, então fica no final)
COPY . /app/
RUN chmod +x scripts/entrypoint.sh

EXPOSE 9090

ENTRYPOINT ["/app/scripts/entrypoint.sh"]