# Este arquivo deve conter somente valores de exemplo, nunca credenciais reais.
# Se precisar adicionar dados sensíveis, use .env e mantenha-o ignorado pelo Git.
GOOGLE_CLOUD_PROJECT=your-google-cloud-project-id

# Must match the ROS_DOMAIN_ID exported by the native ROS2 driver process on the host
ROS_DOMAIN_ID=0
